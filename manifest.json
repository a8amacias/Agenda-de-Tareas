const CACHE = 'mi-app-v1';
const ARCHIVOS = [
  '/',
  '/index.html',
  '/style.css',
  '/script.js',
  '/icono-192.png',
  '/icono-512.png'
];

self.addEventListener('install', (e) => {
  e.waitUntil(caches.open(CACHE).then(c => c.addAll(ARCHIVOS)));
});

self.addEventListener('fetch', (e) => {
  e.respondWith(
    caches.match(e.request).then(r => r || fetch(e.request))
  );
  {
  "name": "Mi Agenda de Tareas",
  "short_name": "Agenda",
  "description": "Una agenda de tareas para tener tus días mas organizados",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0ea5e9",
  "icons": [
    {
      "src": "/icono-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icono-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}

});
